---
// src/components/SEO.astro
import type { ResolvedMetadata } from '../types.ts'
import { createTags } from '@lucky-media/astro-seo/internal/tags'

interface Props {
  metadata: ResolvedMetadata
}
const { metadata } = Astro.props

const tags = createTags(metadata, Astro.url)
---

{tags.map((t) =>
  t.tag === 'title' ? <title>{t.content}</title> : t.tag === 'meta' ? <meta {...t.attrs} /> : <link {...t.attrs} />
)}
